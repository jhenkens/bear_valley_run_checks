// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id        String   @id @default(cuid())
  email     String?  @unique
  name      String
  isAdmin   Boolean  @default(false)
  oidcOnly  Boolean  @default(false) // Set on first OIDC login; disables magic link and passkeys
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions       Session[]
  magicLinks     MagicLink[]
  googleOAuth    GoogleOAuth?
  authenticators Authenticator[]
}

model Authenticator {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  credentialId String    @unique // base64url-encoded credential ID
  publicKey    Bytes                // COSE public key
  counter      Int       @default(0) // Signature counter, guards against cloned authenticators
  transports   String?              // Comma-separated AuthenticatorTransport hints (e.g. "internal,hybrid")
  deviceType   String?              // 'singleDevice' | 'multiDevice'
  backedUp     Boolean   @default(false)
  name         String               // User-facing label, e.g. "Chrome on MacBook"

  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?

  @@index([userId])
}

model MagicLink {
  id        String   @id @default(cuid())
  token     String   @unique
  email     String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String?

  @@index([token])
  @@index([email])
}

model Session {
  id        String   @id
  sid       String   @unique
  data      String
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String?

  @@index([sid])
}

model GoogleOAuth {
  id                  String   @id @default(cuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  accessToken         String   // Current OAuth access token
  refreshToken        String   // OAuth refresh token (for renewals)
  tokenExpiresAt      DateTime // When access token expires

  googleEmail         String   // Google account email (display purposes)
  googleDriveFolderId String   // Selected folder ID for daily spreadsheets
  googleSheetsId      String?  // Optional: master run list spreadsheet ID

  lastTestedAt        DateTime @default(now()) // Last successful API call
  isActive            Boolean  @default(true)  // Can be disabled without deleting

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([userId])
}

// Patrol Board: notes pinned for debrief / morning brief, and lightweight tasks.
// Dates are yyyy-MM-dd strings in the configured timezone (calendar days, not instants).
model BoardItem {
  id               String    @id @default(cuid())
  description      String
  section          String    @default("General")
  authorName       String
  authorId         String?   // Plain reference (no relation) so deleting a user keeps their items
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  isTask           Boolean   @default(false)
  dueDate          String?
  dueHour          Int?      // 8-16 (hour of day, configured timezone); null = end of day (5 PM)
  assignee         String?   // Patroller name (same list as run checks)
  doneAt           DateTime?
  doneBy           String?

  debriefDate      String?   // Pinned for that day's debrief
  morningBriefDate String?   // Shown in that day's morning brief

  archivedAt       DateTime?
  archivedToSheet  Boolean   @default(false)

  photos           BoardPhoto[]

  @@index([archivedAt])
}

model BoardPhoto {
  id           String    @id @default(cuid())
  itemId       String
  item         BoardItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  uploadedBy   String
  createdAt    DateTime  @default(now())
  driveFileId  String?
  driveUrl     String?

  @@index([itemId])
}
